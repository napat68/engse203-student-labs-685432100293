
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# CP52 — JWT Secret
# ใส่ค่าจริงใน .env หรือ Environment Variables ของ Render
# ห้าม commit JWT_SECRET ที่มีค่าจริงลง GitHub
JWT_SECRET=

# อายุของ JWT
JWT_EXPIRES_IN=1h

# ⭐⭐ Challenge Turso — เว้นว่างไว้ = ใช้ campus.db ในเครื่อง
# ค่าจริงใส่ใน .env (ห้าม commit) หรือใน Environment ของ Render
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
